# Copy this file to .env and fill in the real values.
# .env is git-ignored — never commit real credentials.

# --- Database -------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains special characters (@ : / ? # [ ] %),
# URL-encode them (e.g. "p@ss" -> "p%40ss").
DATABASE_URL="postgresql://thaiauction_app:YOUR_PASSWORD_HERE@localhost:5432/thaiauction"

# --- Better Auth ----------------------------------------------------------
# Read automatically by Better Auth from the environment.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="YOUR_SECRET_HERE"
# The public origin of the app, with no trailing slash.
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth ---------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials.
# The authorised redirect URI must be:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"

# --- Thaibulksms OTP (SMS phone verification) -----------------------------
# BOTH are required: every OTP call sends key and secret in the request body.
# These are the OTP credentials from https://otp-manager.thaibulksms.com —
# they are NOT the same as the Send-SMS API key/secret.
THAIBULKSMS_API_KEY="YOUR_THAIBULKSMS_OTP_KEY_HERE"
THAIBULKSMS_API_SECRET="YOUR_THAIBULKSMS_OTP_SECRET_HERE"

# Optional, for development/staging ONLY. Skips the real SMS (which costs
# credit) and accepts the fixed code 000000 instead. The value must be spelled
# out in full to take effect — any other value is rejected outright — so a
# leftover "1" or a copied boolean cannot silently disable SMS verification.
# Never set this on the production VPS.
# OTP_STUB_MODE="stub-sms-no-real-otp"

# --- Uploads --------------------------------------------------------------
# Absolute path where uploaded auction images are written. Keep it OUTSIDE the
# project directory so a redeploy or rebuild cannot delete them, and back this
# directory up. The app must have write permission. Defaults to ./storage/uploads
# when unset, which is fine for local development only.
UPLOAD_DIR="/var/lib/thaiauction/uploads"

# --- Admin ----------------------------------------------------------------
# Comma-separated list of administrator email addresses. Admin rights live here
# rather than in the database on purpose: someone who gains write access to
# PostgreSQL still cannot make themselves an admin and read identity documents.
# Leave unset and nobody is an admin.
ADMIN_EMAILS="you@example.com"

# --- Identity documents (KYC) ---------------------------------------------
# MUST be a different directory from UPLOAD_DIR. Product images are public;
# these are ID cards. Restrict it to the account running the app:
#   sudo install -d -m 700 -o <app-user> -g <app-group> /var/lib/thaiauction/kyc
# Back it up separately, or deliberately not at all — files here are erased as
# soon as a reviewer decides, so backups would outlive the retention rule.
UPLOAD_DIR_KYC="/var/lib/thaiauction/kyc"

# --- Payments (Omise) -----------------------------------------------------
# From the Omise dashboard. Test keys are prefixed pkey_test_ / skey_test_.
#
# The PUBLIC key is sent to the browser on purpose — that is how Omise.js
# tokenises a card without the number ever reaching this server.
OMISE_PUBLIC_KEY="pkey_test_YOUR_PUBLIC_KEY_HERE"
#
# The SECRET key is server-only. It must never appear in client code, a public
# repository, or a browser. Anything that can read it can move money.
OMISE_SECRET_KEY="skey_test_YOUR_SECRET_KEY_HERE"
#
# Required before a LIVE (non-skey_test_) key will be used at all. Without it a
# production key dropped into a staging .env fails loudly instead of quietly
# charging real cards. Set this only on the production VPS.
# OMISE_ALLOW_LIVE="1"
#
# Development only: point the Omise client at a stub. IGNORED unless the secret
# key is a test key, so this can never redirect real money to another host.
# OMISE_API_BASE="http://127.0.0.1:4999"

# --- Payment methods, phase 2 ---------------------------------------------
# Both default to OFF. The code ships without offering either; set to exactly
# "1" to switch one on, then restart. They are read per request, not at build
# time, so no rebuild is needed.
#
# Instalments: the buyer pays the interest (the Omise account has
# zero_interest_installments off), so the platform's cost is the same as an
# ordinary card. Terms are capped at 12 months.
# PAYMENT_INSTALLMENTS_ENABLED="1"
#
# ShopeePay: offered on mobile browsers only, via shopeepay_jumpapp.
# PAYMENT_SHOPEEPAY_ENABLED="1"

# --- Web Push (optional) ---------------------------------------------------
# Without these three the in-app bell works exactly as it does with them; only
# the push announcement is skipped, and the toggle on /account is hidden rather
# than offering a button that cannot work.
#
# Generate a pair ONCE, on any machine, and keep the same pair forever:
#
#   npx web-push generate-vapid-keys
#
# Changing them invalidates every existing subscription — every browser would
# have to be re-enabled by hand — so treat the private half like any other
# secret and back it up with them.
#
# The public half is NEXT_PUBLIC_ deliberately: the browser must pass it to
# pushManager.subscribe, and it is a public key. The private half never leaves
# the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Who to contact about this application's pushes, as a mailto: or an https URL.
# Push services use it to reach an operator whose sending looks broken.
VAPID_SUBJECT="mailto:admin@thaiauction.app"

# --- Automatic payouts (Omise Recipients + Transfers) ----------------------
# Default OFF. Off, /admin/payouts is the manual flow it has always been and no
# recipient is ever created. Set to exactly "1" and an admin's one click sends
# the money through Omise instead. Read per request, so no rebuild is needed.
#
# Omise deducts its transfer fee FROM the transfer, so the fee comes off the
# seller's share before the commission is worked out — see lib/payout-math.ts,
# which carries the measured fee schedule and why it is not the one the account
# advertises.
#
# Switching it on does NOT backfill by itself. Existing sellers need:
#   npm run payouts:backfill-recipients
# and then, on a schedule:
#   npm run payouts:reconcile
# PAYOUT_RECIPIENTS_ENABLED="1"
