# Copy this file to .env and fill in the real password.
# .env is git-ignored — never commit real credentials.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains special characters (@ : / ? # [ ] %),
# URL-encode them (e.g. "p@ss" -> "p%40ss").
DATABASE_URL="postgresql://thaiauction_app:YOUR_PASSWORD_HERE@localhost:5432/thaiauction"
