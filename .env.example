# Copy this file to .env and fill in the real values.
# .env is git-ignored — never commit real credentials.

# --- Database -------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains special characters (@ : / ? # [ ] %),
# URL-encode them (e.g. "p@ss" -> "p%40ss").
DATABASE_URL="postgresql://thaiauction_app:YOUR_PASSWORD_HERE@localhost:5432/thaiauction"

# --- Better Auth ----------------------------------------------------------
# Read automatically by Better Auth from the environment.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="YOUR_SECRET_HERE"
# The public origin of the app, with no trailing slash.
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth ---------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials.
# The authorised redirect URI must be:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"
