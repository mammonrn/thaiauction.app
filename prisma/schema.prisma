// Prisma schema for thai-auction
//
// Docs: https://pris.ly/d/prisma-schema
// Note: the datasource URL is NOT declared here. In Prisma 7 it is supplied by
// `prisma.config.ts`, which reads it from the DATABASE_URL environment variable.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Auction lifecycle.
/// draft     = seller is still editing, not publicly listed
/// active    = open for bidding
/// ended     = finished (time ran out, or bought via buy-now)
/// cancelled = pulled by the seller/admin before it ended

/// Why an auction stopped, kept so the detail page can say "ขายด้วยราคาซื้อทันที"
/// rather than just "จบแล้ว".
enum AuctionEndReason {
  /// endTime passed.
  expired
  /// Someone bid the buy-now price.
  buy_now
  /// The seller closed it early while bids existed.
  seller_ended
  /// The seller closed it early with no bids, so there is no winner.
  seller_cancelled

  @@map("auction_end_reason")
}

/// What a one-time code is allowed to authorise.
///
/// One table holds every OTP challenge, so without this a code sent to change
/// a payout account could be typed into the phone-verification form, or a
/// password-reset code could unlock a bank account. Each flow only ever looks
/// for its own purpose, so a code is spent on the thing it was asked for.
enum OtpPurpose {
  /// Prove a NEW number belongs to you.
  verify_phone
  /// Unlock the payout account for one change, sent to an ALREADY verified
  /// number.
  bank_change
  /// Set a new password while signed out, sent to an already verified number.
  password_reset

  @@map("otp_purpose")
}

/// Where a seller's identity check stands.
enum SellerVerificationStatus {
  pending
  approved
  rejected

  @@map("seller_verification_status")
}

/// How a payment stands with Omise. Mirrors the Charge `status` values we act
/// on; Omise also has `reversed`, which only applies to authorise-then-capture
/// flows this project does not use (every charge is captured immediately).
enum PaymentStatus {
  /// Charge created, money not received yet. A PromptPay QR is waiting to be
  /// scanned, or a card charge is mid-flight.
  pending
  successful
  failed
  /// The QR's window closed before anyone paid it.
  expired

  @@map("payment_status")
}

enum PaymentMethod {
  card
  promptpay
  /// Credit-card instalments through a Thai issuer. The buyer is redirected to
  /// the bank to accept the plan, so the charge settles asynchronously like
  /// PromptPay rather than synchronously like a card.
  installment
  /// ShopeePay, via the app-redirect source (`shopeepay_jumpapp`).
  shopeepay

  @@map("payment_method")
}

/// Where an ended auction stands on getting paid for.
///
/// Kept on the item, not derived from `payments`, because it is the lifecycle
/// fact the settlement sweep reads and writes under the auction's row lock —
/// the same lock bidding uses. `payments` records what the gateway did; this
/// records what the marketplace owes and to whom.
enum AuctionPaymentState {
  /// Nothing to collect: no bids, or the seller cancelled.
  not_applicable
  /// Someone holds the right to buy and their deadline is running.
  awaiting_payment
  paid
  /// Every bidder in turn let their deadline pass. Nothing was sold.
  unpaid

  @@map("auction_payment_state")
}

/// What a notification is about.
///
/// Named for the EVENT, not for who receives it: `new_bid` reaches the seller
/// and `outbid` reaches the person who just lost the lead, and keeping the
/// event in the name is what stops a future reader assuming a notification
/// type implies an audience.
enum NotificationType {
  /// Someone bid on your listing.
  new_bid
  /// Someone bought your listing outright.
  buy_now
  /// Your buyer's payment landed.
  payment_received
  /// Your winner let their deadline lapse.
  payment_missed
  /// Someone outbid you.
  outbid
  /// An auction you have bid on closes within the hour.
  ending_soon
  /// You won.
  auction_won

  @@map("notification_type")
}

/// Why someone reported a listing.
///
/// Four buckets, not a taxonomy: a reporter picks in a second or picks wrong,
/// and an admin opens the listing to judge it either way. `other` carries the
/// free-text note, which is why the note exists at all.
enum ReportReason {
  /// Selling it is against the law — weapons, drugs, protected wildlife.
  illegal
  /// Passed off as genuine when it is not.
  counterfeit
  /// The listing itself is obscene, hateful, or otherwise not publishable.
  inappropriate
  other

  @@map("report_reason")
}

/// What an admin decided about a report.
enum ReportStatus {
  open
  /// Looked at, listing left up.
  dismissed
  /// Looked at, listing taken down.
  actioned

  @@map("report_status")
}

/// What a ban stops someone from doing.
enum BanKind {
  /// No session at all: refused at the login screen.
  login
  /// Signs in normally, but cannot bid or buy outright.
  bidding

  @@map("ban_kind")
}

/// Whether a sold item has been posted.
///
/// Two states on purpose. A third — "delivered" — would have to be entered by
/// the same seller who entered "shipped", and nothing in this marketplace can
/// check it, so it would be a claim wearing the costume of a fact.
enum ShippingStatus {
  not_shipped
  shipped

  @@map("shipping_status")
}

/// Progress of a manual bank transfer to a seller.
enum PayoutStatus {
  pending
  transferred

  @@map("payout_status")
}

/// Whether an item has been used.
///
/// Nullable on the row rather than defaulted: listings created before this
/// question existed genuinely have no answer, and defaulting them to `used`
/// would be the app asserting something the seller never said. They render as
/// "ไม่ระบุ" until edited.
enum ItemCondition {
  brand_new
  used

  @@map("item_condition")
}

enum AuctionStatus {
  draft
  active
  ended
  cancelled

  @@map("auction_status")
}

/// Application user.
/// Field shapes deliberately match Better Auth's core `user` model so it can be
/// wired up later without a destructive migration: String id, Boolean
/// emailVerified (NOT a nullable DateTime like Auth.js uses), and updatedAt.

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  /// Required (not String?) to match Better Auth's user table contract, which
  /// declares name as a required string and always supplies one on sign-up.
  name          String
  image         String?
  emailVerified Boolean @default(false)

  /// Legal identity, supplied by sellers before submitting an ID document so a
  /// reviewer has something to compare the card against. Separate from `name`,
  /// which is the display name Better Auth takes from the OAuth profile — a
  /// nickname there is fine, but it is not what is printed on the card.
  ///
  /// Nullable because buyers never provide it: only sellers go through KYC.
  /// Kept permanently, unlike the ID image: this is ordinary personal data and
  /// it is what the approval actually attests to.
  firstName   String?
  lastName    String?
  /// Date only. Stored at UTC midnight so the calendar date cannot shift when
  /// rendered in another timezone.
  dateOfBirth DateTime?

  /// Storage key for a profile picture the user uploaded themselves, e.g.
  /// "avatars/<userId>/<uuid>.webp". Takes precedence over `image`, which is
  /// whatever Google supplied at sign-in — kept as the fallback so an account
  /// that never uploads one still has a picture.
  avatarKey String?

  /// When this seller accepted the selling terms — including the platform's
  /// commission. Recorded rather than assumed: the commission is the one term
  /// a seller is entitled to have seen before listing, so there has to be a
  /// timestamp proving they were shown it.
  ///
  /// Null means they have never listed anything, or listed before the terms
  /// step existed; either way they are asked once before their next listing.
  sellerTermsAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingAddresses     ShippingAddress[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  submittedReports      ItemReport[]      @relation("SubmittedReports")
  reviewedReports       ItemReport[]      @relation("ReviewedReports")
  bansReceived          UserBan[]         @relation("BansReceived")
  bansIssued            UserBan[]         @relation("BansIssued")
  deletedItems          AuctionItem[]     @relation("DeletedItems")
  verifiedPhones        VerifiedPhone[]
  sellerVerifications   SellerVerification[] @relation("SubmittedVerifications")
  reviewedVerifications SellerVerification[] @relation("ReviewedVerifications")
  phoneOtpRequests      PhoneOtpRequest[]
  auctionItems          AuctionItem[]        @relation("SellerAuctionItems")
  wonAuctionItems       AuctionItem[]        @relation("WonAuctionItems")
  bids                  Bid[]
  payments              Payment[]
  paidOutPayments       Payment[]            @relation("PayoutMarkedBy")
  strikes               PaymentStrike[]
  bankAccount           SellerBankAccount?

  sessions Session[]
  accounts Account[]

  @@map("users")
}

/// Delivery address for a winning bidder.
/// Thai addresses are stored as components rather than one free-text blob so
/// shipping cost (which depends on province) and postcode validation are possible.

model ShippingAddress {
  id            String   @id @default(cuid())
  userId        String
  recipientName String
  phone         String
  /// House number, street, village/building — the free-form part.
  addressLine   String
  /// ตำบล/แขวง
  subDistrict   String
  /// อำเภอ/เขต
  district      String
  /// จังหวัด
  province      String
  /// รหัสไปรษณีย์ (5 digits)
  postalCode    String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // A user's addresses are personal data with no financial meaning, so they are
  // removed together with the account.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Supports "list my addresses" and "find my default address".
  @@index([userId, isDefault])
  @@map("shipping_addresses")
}

/// Item category shown in the marketplace navigation.

model Category {
  id   String @id @default(cuid())
  /// Thai display name, e.g. "พระเครื่อง"
  name String @unique
  /// ASCII URL segment, e.g. "amulets" — keeps category URLs readable and
  /// avoids percent-encoded Thai in links and analytics.
  slug String @unique

  auctionItems AuctionItem[]

  @@map("categories")
}

/// A single item put up for auction.

model AuctionItem {
  id          String @id @default(cuid())
  sellerId    String
  categoryId  String
  title       String
  description String

  /// New or second-hand. Required on new listings; null only on ones that
  /// predate the field.
  condition ItemCondition?

  /// Ordered image URLs; images[0] is the cover image.
  images String[]

  /// All money is stored as INTEGER SATANG (1 baht = 100 satang).
  /// Integers are exact — no floating-point drift — and stay plain JS numbers,
  /// unlike Prisma's Decimal (a Decimal.js object that cannot cross the
  /// server/client boundary without conversion). Use lib/money.ts to format.
  startPrice   Int
  /// Denormalised highest bid so listing pages don't need an aggregate over
  /// `bids` for every row. Seeded from startPrice when the auction is created.
  currentPrice Int
  /// Optional "ซื้อทันที" price. Null = buy-now disabled for this item.
  buyNowPrice  Int?
  /// Smallest step a new bid must clear the current price by, in satang.
  /// Set by the seller when listing; enforced by the bidding system.
  /// Defaults to 1000 satang (฿10) so existing rows get a sane step.
  bidIncrement Int  @default(1000)

  /// Null = no fixed closing time; the seller ends the auction manually.
  endTime DateTime?

  status AuctionStatus @default(draft)

  /// Settlement, written once when the auction stops. The winner is recorded
  /// rather than derived from the bids, so the outcome is a fixed fact even if
  /// the bid history is ever archived or re-read differently later.
  endedAt   DateTime?
  endReason AuctionEndReason?
  /// Who currently holds the right to buy. This is NOT frozen at settlement:
  /// if the winner lets their deadline pass, the right moves to the next
  /// highest bidder and this column moves with it. Null once nobody is left.
  winnerId  String?

  paymentState AuctionPaymentState @default(not_applicable)
  /// When the current holder's right to buy lapses. Null when no offer is live.
  paymentDueAt DateTime?

  /// When an admin took this listing down. Null = visible.
  ///
  /// Soft, not a DELETE. A listing is referenced by bids, payments, strikes and
  /// reports, and it is the thing an admin's decision was ABOUT — erasing the
  /// row would erase the evidence for the removal along with it, and orphan a
  /// buyer's own bid history. Every public query filters on this; the admin
  /// pages deliberately do not.
  deletedAt   DateTime?
  deletedById String?
  /// What the admin recorded as the reason, shown to the seller.
  deletedReason String?

  /// Whether the seller has posted it. Manual: nobody is talking to a courier,
  /// so this is the seller's own statement and nothing verifies it.
  shippingStatus ShippingStatus @default(not_shipped)
  /// The courier's tracking number, as typed by the seller. Free text because
  /// every Thai courier formats theirs differently and guessing a pattern would
  /// reject valid numbers.
  trackingNumber String?

  /// Where this item is going — COPIED from the buyer's address book when the
  /// payment attempt is made, never referenced by id.
  ///
  /// A snapshot, because an address book entry is a live row the buyer keeps
  /// editing: correcting a typo, or deleting the address once they have moved.
  /// A sold order must keep saying where it was sent, so the fields are frozen
  /// here at the moment of purchase. Null on orders that predate this, and on
  /// anything never paid for.
  shipToName       String?
  shipToPhone      String?
  shipToLine       String?
  shipToSubDistrict String?
  shipToDistrict   String?
  shipToProvince   String?
  shipToPostalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict, not Cascade: an auction is a financial record. Deleting a seller
  // must not silently erase auctions other people bid on.
  seller   User            @relation("SellerAuctionItems", fields: [sellerId], references: [id], onDelete: Restrict)
  winner   User?           @relation("WonAuctionItems", fields: [winnerId], references: [id], onDelete: Restrict)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bids     Bid[]
  payments Payment[]
  strikes  PaymentStrike[]
  reports  ItemReport[]
  deletedBy User?          @relation("DeletedItems", fields: [deletedById], references: [id], onDelete: Restrict)

  // "Live auctions, soonest ending first" — the main marketplace query.
  // Category browse pages.
  // A seller's own listings.
  // Sweeping auctions whose time has passed but that nobody has opened yet.
  @@index([status, endTime])
  // Public listing queries all filter deletedAt IS NULL first.
  @@index([deletedAt, status])
  // Sweeping offers whose 24-hour deadline has passed.
  @@index([paymentState, paymentDueAt])
  @@index([winnerId])
  @@index([categoryId, status])
  @@index([sellerId])
  @@map("auction_items")
}

/// A bid placed on an auction item. Append-only: bids are never edited.

model Bid {
  id            String   @id @default(cuid())
  auctionItemId String
  bidderId      String
  /// Integer satang, same convention as AuctionItem prices.
  amount        Int
  createdAt     DateTime @default(now())

  /// Where the bid came from, kept only to spot shill rings — several accounts
  /// bidding from one machine on one seller's items. Nullable because these are
  /// ERASED after 180 days (scripts/prune-bid-metadata.ts) while the bid itself
  /// is kept forever: the bid is a financial record, the network metadata is
  /// not. Never shown to other users; the admin fraud page is the only reader.
  ipAddress String?
  userAgent String?

  auctionItem AuctionItem @relation(fields: [auctionItemId], references: [id], onDelete: Cascade)
  // Restrict: a bid is a binding record, so a bidder cannot be deleted out from
  // under an auction they are winning.
  bidder      User        @relation(fields: [bidderId], references: [id], onDelete: Restrict)

  // Two bids on the same item can never share an amount. This turns the classic
  // "two users bid the same value at once" race into a database-level conflict
  // instead of a tie the application has to guess at.
  // Bid history for an item, highest first.
  // "My bids" page.
  @@unique([auctionItemId, amount])
  @@index([auctionItemId, amount(sort: Desc)])
  @@index([bidderId])
  // The fraud sweep groups recent bids by origin.
  @@index([ipAddress, createdAt])
  @@map("bids")
}

/// Better Auth session. Generated by `@better-auth/cli generate`; the only
/// hand edit is @@map, to match this project's snake_case plural table names.
/// Sessions are stored in the database (no JWT), so signing out or revoking a
/// session takes effect on the very next request.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

/// Better Auth credential/OAuth account. One row per sign-in method per user,
/// which is what makes account linking possible: a Google user who later calls
/// `setPassword` gains a second row with providerId "credential" and a password
/// hash, while the Google row keeps its OAuth tokens.
model Account {
  id                    String    @id
  /// Identifies which system issued this account: the OAuth issuer for a
  /// social login, or a locally-generated issuer for a "credential" row.
  /// Required by better-auth 1.7.2 and used together with accountId to
  /// uniquely identify an external identity.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Better Auth short-lived tokens (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// A phone number this user has proved they control, via an SMS OTP.
///
/// Verification is recorded per (user, number) rather than on the user or on
/// each shipping address: one user legitimately has several numbers (their own
/// plus a recipient's), the same number is often reused across addresses and
/// should not cost another SMS, and this keeps a durable record of when each
/// was proved.
model VerifiedPhone {
  id     String @id @default(cuid())
  userId String
  /// Normalised Thai mobile number, e.g. "0812345678".
  phone  String

  verifiedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([userId])
  @@map("verified_phones")
}

/// One outstanding OTP challenge.
///
/// Thaibulksms generates, sends and checks the PIN itself, so no code is stored
/// here — only the opaque `token` its request endpoint returns, which is what
/// its verify endpoint expects back. Rows are kept after use as the audit trail
/// that the rate limits are computed from.
model PhoneOtpRequest {
  id     String @id @default(cuid())
  userId String
  phone  String

  /// Opaque handle from Thaibulksms; passed back on verify. Never shown to the
  /// user and never accepted from the client.
  token String
  /// Short reference shown in the SMS so the user can match code to request.
  refno String

  /// What this code may be used for. Defaults to verify_phone so rows written
  /// before this column existed keep their original meaning.
  purpose OtpPurpose @default(verify_phone)

  /// Wrong-PIN count, to stop a 6-digit code being brute-forced.
  attempts   Int       @default(0)
  /// Local copy of the expiry, so an obviously dead challenge is rejected
  /// without spending a Thaibulksms API call.
  expiresAt  DateTime
  /// Set once the challenge succeeds, so a token cannot be replayed.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Finding the newest live challenge, and counting recent sends per number
  // for the rate limit.
  @@index([userId, phone, purpose, createdAt])
  @@index([phone, createdAt])
  @@map("phone_otp_requests")
}

/// A seller's identity check: one row per submission, kept as the audit trail.
///
/// The uploaded ID image is DELETED the moment a decision is made — see
/// documentKey/documentDeletedAt. What survives is the decision itself: who
/// decided, when, and why if refused. A Thai national ID card can show
/// ศาสนา (religion), which is sensitive personal data under PDPA s.26, so the
/// image is held only for as long as a human needs it to make the call.
model SellerVerification {
  id     String                   @id @default(cuid())
  userId String
  status SellerVerificationStatus @default(pending)

  /// Storage key for the ID image while the request is pending.
  /// Null once decided or withdrawn, because the file has been erased.
  documentKey       String?
  /// When the image was erased, kept as evidence the retention rule ran.
  documentDeletedAt DateTime?

  submittedAt DateTime @default(now())

  // --- audit trail -------------------------------------------------------
  reviewedAt      DateTime?
  reviewedById    String?
  /// Shown to the seller so a refusal is actionable.
  rejectionReason String?

  user       User  @relation("SubmittedVerifications", fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: an admin who made decisions cannot be deleted out from under the
  // audit trail.
  reviewedBy User? @relation("ReviewedVerifications", fields: [reviewedById], references: [id], onDelete: Restrict)

  // The admin queue, oldest first.
  @@index([status, submittedAt])
  // A seller's own history, newest first.
  @@index([userId, submittedAt])
  @@map("seller_verifications")
}

/// One attempt to pay for a won auction.
///
/// Every row corresponds to a real Omise Charge, so this table is the local
/// mirror of what the gateway did — never a substitute for it. Status is only
/// ever written from a Retrieve Charge response (`GET /charges/{id}`), never
/// from anything the browser sends, because the browser is not a party we can
/// trust about whether money moved.
///
/// A failed or expired attempt is KEPT rather than replaced. Two things depend
/// on that: the buyer can see why a card was declined, and a partial-outage
/// investigation can reconstruct the order of events.
model Payment {
  id            String @id @default(cuid())
  auctionItemId String
  /// Who is paying. Always the auction's current winner at the time the charge
  /// was created — checked server-side, never taken from the request body.
  payerId       String

  method PaymentMethod
  status PaymentStatus @default(pending)

  /// Omise's charge id (`chrg_...`). Unique, so the same charge can never be
  /// recorded twice even if two requests race to write it.
  omiseChargeId String @unique

  // --- money, integer satang throughout --------------------------------
  /// What the buyer owes: the winning bid. Read from the auction row on the
  /// server; a client-supplied amount is never trusted.
  amount Int

  /// Straight from the Charge object once it succeeds — Omise's real numbers,
  /// not an estimate of them. Null while the charge is still pending.
  /// `net` is Omise's own "amount after fees, interest and VAT", so
  /// commission is taken from it rather than from `amount`.
  fee        Int?
  feeVat     Int?
  net        Int?
  /// 10% of `net`, floored, so the platform never rounds in its own favour.
  commission Int?
  /// `net - commission`. What the seller is owed, to the satang.
  sellerNet  Int?

  /// Omise's own words when a charge fails, shown to the buyer so a decline is
  /// actionable ("insufficient funds" vs "wrong CVV").
  failureCode    String?
  failureMessage String?

  /// PromptPay only: where the QR image lives, and when it stops being valid.
  qrDownloadUri String?
  expiresAt     DateTime?

  /// Where the buyer must be sent to authorise an instalment plan or a
  /// ShopeePay payment. Stored rather than held in the page, so a buyer who
  /// closes the tab can be handed the same link again instead of being made to
  /// start a second charge — which the one-pending index would refuse anyway.
  ///
  /// It is a single-use authorisation URL, not a secret, and it is only ever
  /// returned to the payer.
  authorizeUri String?

  /// Instalments only. Which issuer and how many months, as sent to Omise —
  /// kept so a payout dispute can be read back without calling the API.
  installmentBank String?
  installmentTerm Int?

  /// Instalments only: what the interest cost, straight from the Charge.
  /// The buyer bears it (the account does not send zero_interest_installments),
  /// so this is recorded for the audit trail rather than deducted from the
  /// seller — `net` already has it removed by Omise where applicable.
  interest    Int?
  interestVat Int?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // --- payout to the seller (manual bank transfer) ----------------------
  payoutStatus        PayoutStatus @default(pending)
  payoutAt            DateTime?
  /// The bank's transaction reference, typed in by the admin who sent it.
  payoutReference     String?
  payoutById          String?
  /// The account actually paid, snapshotted at transfer time. The seller may
  /// change their bank details later; what was paid must not change with them.
  payoutAccountNumber String?
  payoutAccountName   String?

  auctionItem AuctionItem @relation(fields: [auctionItemId], references: [id], onDelete: Restrict)
  // Restrict throughout: a payment is a financial record. Nobody involved in
  // one can be deleted out from under it.
  payer       User        @relation(fields: [payerId], references: [id], onDelete: Restrict)
  payoutBy    User?       @relation("PayoutMarkedBy", fields: [payoutById], references: [id], onDelete: Restrict)

  // The payout queue: what is paid but not yet transferred.
  @@index([status, payoutStatus])
  // A buyer's payment history, and reconciling one auction's attempts.
  @@index([auctionItemId, createdAt])
  @@index([payerId, createdAt])
  // The reconcile sweep: pending charges to re-check against Omise.
  @@index([status, createdAt])
  @@map("payments")
}

/// A recorded failure to pay for an auction that was won.
///
/// One row per (user, auction), enforced by the unique index — a single missed
/// deadline can never count twice, however many times a sweep runs over it.
/// Three strikes removes the right to bid; see lib/strikes.ts.
///
/// This doubles as the record of who has already forfeited a given auction, so
/// the re-offer loop knows not to come back to them.
model PaymentStrike {
  id            String @id @default(cuid())
  userId        String
  auctionItemId String

  /// What was owed when the deadline passed, kept so an admin reviewing a ban
  /// can see the scale of what went unpaid.
  amount Int

  createdAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  auctionItem AuctionItem @relation(fields: [auctionItemId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionItemId])
  // Counting a user's strikes, and listing them newest first.
  @@index([userId, createdAt])
  @@map("payment_strikes")
}

/// Where a seller's share is sent. One account per seller.
///
/// Held separately from `users` so the sensitive-ish banking details are not
/// selected by accident on any query that reads a user, and so the whole record
/// can be dropped without touching the account.
model SellerBankAccount {
  id     String @id @default(cuid())
  userId String @unique

  /// Bank identifier from lib/thai-banks.ts, e.g. "kbank".
  bankCode      String
  accountNumber String
  /// The holder name exactly as the bank prints it.
  accountName   String

  /// Whether `accountName` matched the seller's KYC name when it was saved.
  /// Recorded rather than enforced: Thai bank names carry title prefixes and
  /// inconsistent spacing, so a mismatch is a flag for the admin who releases
  /// the payout, not a reason to refuse the account. Recomputed on every save.
  nameMatchesKyc Boolean @default(false)

  /// While set and in the future, the form accepts ONE change.
  ///
  /// The first save is free — there is nothing to protect yet. After that the
  /// account is where money goes, so changing it is the single most valuable
  /// thing an attacker with a stolen session could do. An OTP to an already
  /// verified number opens this window; saving closes it again.
  unlockedUntil DateTime?

  /// The verified number the open unlock was sent to, copied into the audit
  /// when the change lands. Cleared with the unlock.
  unlockedByPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes BankAccountChange[]

  @@map("seller_bank_accounts")
}

/// Every change to a payout account after the first save.
///
/// Kept because a redirected payout is only discoverable after the fact: the
/// seller says the money never arrived, and this is the record of when the
/// destination moved and which number authorised it. Both sides of the change
/// are stored — a log that says only "it changed" cannot trace where to.
model BankAccountChange {
  id     String @id @default(cuid())
  userId String

  previousBankCode      String
  previousAccountNumber String
  previousAccountName   String

  newBankCode       String
  newAccountNumber  String
  newAccountName    String
  /// Whether the NEW name matched KYC, so a reviewer can see at a glance
  /// whether a change moved money towards a different person.
  newNameMatchesKyc Boolean

  /// The verified number the unlocking OTP was sent to.
  authorisedByPhone String

  changedAt DateTime @default(now())

  account SellerBankAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, changedAt])
  @@map("bank_account_changes")
}

/// Throttle for the signed-out password reset.
///
/// The email is stored as a SHA-256 hash, never in the clear: the flow answers
/// identically whether or not an account exists, and a table listing the
/// addresses people tried to reset would give away exactly what the answers
/// are careful not to.
model PasswordResetRequest {
  id String @id @default(cuid())

  /// SHA-256 of the lowercased, trimmed email address.
  emailHash String
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipAddress, createdAt])
  @@map("password_reset_requests")
}


/// One person's report of one listing.
///
/// Unique on (auctionItemId, reporterId): reporting the same listing twice is
/// the same person still unhappy, not two independent signals, and the count
/// an admin sorts by has to mean "how many people", or one determined reporter
/// could push anything to the top of the queue. A second attempt updates the
/// reason rather than adding a row.
model ItemReport {
  id            String @id @default(cuid())
  auctionItemId String
  reporterId    String

  reason ReportReason
  /// Only meaningful for `other`, and capped in the action layer.
  note   String?

  status     ReportStatus @default(open)
  reviewedAt DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade: a report is about a listing and means nothing without it. Hard
  // deletion is not how listings are removed (see deletedAt), so this fires
  // only if a draft is deleted outright.
  auctionItem AuctionItem @relation(fields: [auctionItemId], references: [id], onDelete: Cascade)
  // Restrict: who reported is part of the record an admin judges.
  reporter    User        @relation("SubmittedReports", fields: [reporterId], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("ReviewedReports", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([auctionItemId, reporterId])
  @@index([status, createdAt])
  @@index([auctionItemId])
  @@map("item_reports")
}

/// A time-boxed ban applied by an admin.
///
/// Deliberately NOT the strike system. Strikes are automatic, permanent and
/// earned by missing payment deadlines; this is a human decision with an end
/// date. Keeping them apart means neither can quietly change the other's
/// meaning, and lib/bidding.ts keeps counting strikes exactly as it did.
///
/// Rows are never deleted or edited when a ban ends — expiry is `expiresAt`
/// passing, so a ban lifts itself with nobody logging in to do it, and the
/// history stays readable. `liftedAt` records an admin ending one EARLY, which
/// is a different fact from it running its course.
model UserBan {
  id     String  @id @default(cuid())
  userId String
  kind   BanKind

  reason String

  /// Null = permanent. An expiry in the past is simply no longer in force.
  expiresAt DateTime?
  /// Set when an admin ends it before expiry; the row stays for the history.
  liftedAt  DateTime?

  bannedById String
  createdAt  DateTime @default(now())

  user     User @relation("BansReceived", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User @relation("BansIssued", fields: [bannedById], references: [id], onDelete: Restrict)

  // "Is this person banned right now?", asked on every login and every bid.
  @@index([userId, kind, expiresAt])
  @@index([userId, createdAt])
  @@map("user_bans")
}


/// One thing that happened, addressed to one person.
///
/// The source of truth for the bell. Web Push is only a loudspeaker held up to
/// these rows: a push that fails to send changes nothing here, which is why
/// the row is written first and the push attempted afterwards.
///
/// The text is FROZEN at creation rather than rendered from the auction on
/// read. A notification is a record of what was true when it happened — "มีคน
/// เสนอราคา ฿1,200" stays right after the price moves to ฿5,000, and it
/// survives the listing being removed by an admin.
model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType

  title String
  body  String
  /// Where the bell sends them. Always an in-app path, never an absolute URL:
  /// this is rendered into an href and into a push payload, and an
  /// attacker-supplied origin has no business in either.
  url   String

  /// What this notification is ABOUT, for collapsing repeats — usually
  /// "<type>:<auctionItemId>".
  ///
  /// Explicit rather than inferred from `url`, because the two answer
  /// different questions: `url` is where the reader is sent, and a seller's
  /// "you were paid" sends them to /sell, which is the same path for every
  /// item they ever sell. Deduplicating on that would collapse unrelated
  /// sales into one line.
  dedupeKey String?

  /// Null = unread. A nullable timestamp rather than a boolean, so "when did
  /// they see it" is answerable without a second column.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The bell's own query: how many are unread for this person.
  @@index([userId, readAt])
  // The list page, newest first.
  @@index([userId, createdAt])
  // Deduplication looks up "one about this thing, for this person".
  @@index([userId, dedupeKey])
  @@map("notifications")
}

/// One browser's permission to be pushed to.
///
/// Per DEVICE, not per person: a seller with a phone and a desktop has two,
/// and one going stale must not silence the other. `endpoint` is unique
/// because it IS the address the push service routes on — the same browser
/// re-subscribing yields the same endpoint, and a duplicate row would only
/// send the same notification twice.
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  /// The push service's URL for this browser. Unique, and the natural key.
  endpoint String @unique
  /// The two halves of the browser's encryption key, from PushSubscription
  /// .toJSON().keys. Useless without the endpoint and not secret on their own.
  p256dh   String
  auth     String

  createdAt  DateTime @default(now())
  /// Last time a push to this endpoint was accepted. A subscription the push
  /// service rejects with 404/410 is deleted rather than dated.
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
